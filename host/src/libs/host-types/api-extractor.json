{
	"$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
	"projectFolder": "../..",
	"mainEntryPointFilePath": "<projectFolder>/dist/libs/host-types/src/index.d.ts",
	"bundledPackages": [
		"@host/platform"
	],
	"dtsRollup": {
		"enabled": true,
		"publicTrimmedFilePath": "<projectFolder>/dist/libs/host-types/host-types.public.d.ts"
	},
	"apiReport": {
		"enabled": false
	},
	"docModel": {
		"enabled": false
	},
	"compiler": {
		"tsconfigFilePath": "tsconfig.lib.json"
	},
	"messages": {
		"compilerMessageReporting": {
			"default": {
				"logLevel": "warning"
			}
		}
	}
}